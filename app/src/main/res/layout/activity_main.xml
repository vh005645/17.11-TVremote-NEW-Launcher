<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Redmi TV"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điều khiển Xiaomi MiTV qua Cloud &amp; LAN"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleSettings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/btn_secondary"
                android:drawableLeft="@drawable/ic_settings"
                android:drawablePadding="6dp"
                android:text="Cài đặt"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingLeft="10dp"
                android:paddingRight="12dp" />
        </LinearLayout>

        <!-- CARD TV MODE (MỚI): Chi dung khi cai APK nay tren TV. Tren DT thi khong can bat. -->
        <LinearLayout
            android:id="@+id/cardTvMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 CHẾ ĐỘ TV - NHẬN LỆNH"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvTvModeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trên điện thoại: không cần bật. Trên TV: bấm “Bật nhận lệnh”."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStartTvReceiver"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_success"
                    android:drawableLeft="@drawable/ic_power"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Bật nhận lệnh"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:layout_marginRight="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />

                <Button
                    android:id="@+id/btnStopTvReceiver"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:gravity="center"
                    android:text="Dừng nhận lệnh"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:layout_marginLeft="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV tự bật khi khởi động lại TV. Launcher vẫn giữ cổng 8999, Receiver nghe cổng 9000."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- CARD SETTINGS: CẤU HÌNH CLOUD FIREBASE (Mặc định ẩn, bấm CÀI ĐẶT để hiện) -->
        <LinearLayout
            android:id="@+id/cardCloudConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ CẤU HÌNH TÀI KHOẢN FIREBASE"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Firebase Database URL:"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etFirebaseUrl"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/input_bg"
                android:hint="https://xxx-default-rtdb.firebaseio.com"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="textUri"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Database Secret Key:"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etFirebaseSecret"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/input_bg"
                android:hint="Nhập secret key của bạn"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="textPassword"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="13sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnSaveCloudConfig"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_primary"
                android:text="Lưu cấu hình"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 CẤU HÌNH GEMINI API KEY"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini API Key (AI Giá Xăng &amp; Vàng):"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etGeminiApiKey"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/input_bg"
                android:hint="Nhập Gemini API Key (AIza...)"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSyncGeminiKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_success"
                android:text="Lưu &amp; gửi sang TV"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 BÁO HOẠT ĐỘNG TV QUA TELEGRAM"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cbTelegramEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bật gửi app &amp; nội dung TV về Telegram"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:buttonTint="#38BDF8"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram Bot Token:"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etTelegramBotToken"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/input_bg"
                android:hint="vd: 123456789:AAH..."
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telegram Chat ID:"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etTelegramChatId"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/input_bg"
                android:hint="vd: -1001234567890 hoặc ID cá nhân"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="textNoSuggestions"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSyncTelegramConfig"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_primary"
                android:text="Lưu &amp; gửi sang TV"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌤️ ĐỒNG BỘ VỊ TRÍ THỜI TIẾT TV"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Địa danh (Xã, Phường, Thị trấn, Quận/Huyện, Tỉnh):"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etWeatherCity"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/input_bg"
                android:hint="Vd: Phường Linh Tây, TP. Thủ Đức"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="textCapWords"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vĩ độ (Lat):"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp" />

                    <EditText
                        android:id="@+id/etWeatherLat"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/input_bg"
                        android:hint="10.8525"
                        android:textColorHint="#64748B"
                        android:textColor="#FFFFFF"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kinh độ (Lon):"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginBottom="2dp" />

                    <EditText
                        android:id="@+id/etWeatherLon"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/input_bg"
                        android:hint="106.7578"
                        android:textColorHint="#64748B"
                        android:textColor="#FFFFFF"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnGetGpsLocation"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/btn_secondary"
                    android:text="📍 Lấy GPS"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnGeocodeSearch"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/btn_secondary"
                    android:text="🔍 Tìm tọa độ"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSyncWeatherToTv"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/btn_primary"
                    android:text="Đồng bộ sang TV"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnResetWeatherAuto"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/btn_secondary"
                    android:text="🔄 Về tự động"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 0: CHỌN PHƯƠNG THỨC KẾT NỐI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHẾ ĐỘ KẾT NỐI"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCloud"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="🌐 Qua Internet"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbLan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📶 Mạng LAN"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- CARD 1A (MỚI): CHỤP ẢNH MÀN HÌNH TV - nằm dưới khu "Chế độ kết nối" -->
        <LinearLayout
            android:id="@+id/cardScreenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 CHỤP ẢNH MÀN HÌNH TV"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem TV đang chiếu gì, ngay trên điện thoại."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/ivScreenshot"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/input_bg"
                android:scaleType="fitCenter"
                android:contentDescription="Ảnh chụp màn hình TV"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvScreenshotStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có ảnh. Bấm “Chụp ảnh” để xem."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTakeScreenshot"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:drawableLeft="@drawable/ic_camera"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Chụp ảnh"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:layout_marginRight="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />

                <Button
                    android:id="@+id/btnClearScreenshot"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:gravity="center"
                    android:text="Xoá ảnh"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:layout_marginLeft="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ảnh chỉ hiển thị trên điện thoại, không lưu lên TV."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- CARD 1B (MỚI): GỬI TIN NHẮN LÊN MÀN HÌNH TV - nằm dưới khu "Chụp ảnh màn hình TV" -->
        <LinearLayout
            android:id="@+id/cardTvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 GỬI TIN NHẮN LÊN TV"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tin nhắn hiện trên TV: nền tối 50%, chữ trắng."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etTvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="88dp"
                android:background="@drawable/input_bg"
                android:hint="Nhập tin nhắn muốn hiện lên TV…"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top"
                android:maxLength="500"
                android:maxLines="5"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvMessageCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 / 500"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="right"
                android:layout_marginBottom="10dp" />

            <!-- Xem trước đúng kiểu hiển thị trên TV: nền đen 50%, chữ trắng -->
            <TextView
                android:id="@+id/tvMessagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="#80000000"
                android:text="Xem trước: —"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSendTvMessage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:drawableLeft="@drawable/ic_message"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Gửi lên TV"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:layout_marginRight="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />

                <Button
                    android:id="@+id/btnClearTvMessage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:gravity="center"
                    android:text="Xoá tin nhắn"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:layout_marginLeft="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 1: CẤU HÌNH IP TV (Chỉ cần khi chọn LAN) -->
        <LinearLayout
            android:id="@+id/cardLanConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KẾT NỐI TV (MẠNG LAN)"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Địa chỉ IP Smart TV"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etIp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="Vd: 192.168.1.50"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:inputType="textUri"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnScan"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/btn_secondary"
                    android:drawableLeft="@drawable/ic_scan"
                    android:drawablePadding="6dp"
                    android:text="QUÉT IP"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 2: HẠN CHẾ THỜI GIAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GIỚI HẠN THỜI GIAN DÙNG"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thời gian cho phép xem (phút)"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etMinutes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_bg"
                android:hint="Nhập số phút (Vd: 15, 30, 45, 60...)"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSetLimit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:drawableLeft="@drawable/ic_timer"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Đặt giới hạn"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginRight="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />

                <Button
                    android:id="@+id/btnStopTime"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_danger"
                    android:drawableLeft="@drawable/ic_power"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Dừng đếm giờ"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginLeft="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />
            </LinearLayout>

            <!-- (MỚI) Trạng thái + nút Mở khoá giới hạn : huỷ giới hạn, xem không giới hạn -->
            <TextView
                android:id="@+id/tvLimitStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng thái: Chưa đặt giới hạn"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnUnlockLimit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_success"
                android:drawableLeft="@drawable/ic_unlock"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="Mở khoá giới hạn"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mở khoá = huỷ giới hạn đã đặt, TV xem không giới hạn."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- CARD 3: ĐIỀU KHIỂN NHANH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐIỀU KHIỂN TỨC THÌ"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Nút Điều khiển Nguồn TV: TẮT & MỞ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btnPowerOff"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/btn_danger"
                    android:drawableLeft="@drawable/ic_power"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="Tắt TV"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />

                <Button
                    android:id="@+id/btnPowerOn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_success"
                    android:drawableLeft="@drawable/ic_power"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="Mở TV"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />
            </LinearLayout>

            <!-- (MỚI) Khoá màn hình: màn hình đen, hiện chữ "Tắt TV ngay !" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btnLockScreen"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/btn_danger"
                    android:drawableLeft="@drawable/ic_lock"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Khoá màn hình"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />

                <Button
                    android:id="@+id/btnUnlockScreen"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_secondary"
                    android:drawableLeft="@drawable/ic_unlock"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Mở khoá màn hình"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khoá: màn hình đen, hiện “Tắt TV ngay !”. Mở khoá để xem lại."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Nút Điều hướng Nhanh: HOME & BACK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btnHome"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/btn_primary"
                    android:drawableLeft="@drawable/ic_home"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Trang chủ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_secondary"
                    android:drawableLeft="@drawable/ic_back"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Quay lại"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>

            <!-- Nút Tăng / Giảm Âm Lượng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/btn_secondary"
                    android:drawableLeft="@drawable/ic_volume_down"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Giảm âm"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp" />

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_secondary"
                    android:drawableLeft="@drawable/ic_volume_up"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:text="Tăng âm"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trạng thái phản hồi / Log -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Chế độ Cloud sẵn sàng"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>